SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY
# Configure Wrangler [vars] ADMIN_EMAILS (comma-separated verified Google email addresses); blank disables promotion.
# Role sync runs on /api/auth/session; remove address to demote at next session POST.
ADMIN_EMAILS=
DB_DATABASE_ID=00000000-0000-0000-0000-000000000001
AI_DB_DATABASE_ID=00000000-0000-0000-0000-000000000002
CANONICAL_HOST=your-domain.example
WWW_HOST=www.your-domain.example
# Optional Worker secret (wrangler secret put ANTHROPIC_API_KEY), never committed: lets Claude triage student question reports.
# ANTHROPIC_API_KEY=
# Local Prepzy importer only: paste localStorage.accessToken from a signed-in prepzy.app tab into .env.
PREPZY_TOKEN=
