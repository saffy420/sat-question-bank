.env
.dev.vars*
.e2e.*.env
.opencode/pipeline/*/e2e/
.omp/pipeline/*/e2e/
playwright-report/
test-results/
.wrangler/
node_modules/
*.db
.database_id
public/qimg/
public/lesson-ui/
.claude/
.superpowers/
extract_math/
extract_rw/
# The extractor is the only way to rebuild the bank from the PDFs, so keep its
# source. The blobs it reads and writes (glyph index, jsonl dumps) stay out.
tools/*
!tools/e2e_*.cjs
!tools/e2e_*.sql
!tools/e2e_unset.env
!tools/*.py
!tools/glyph_labels.json
!tools/apply_math.cjs
!tools/audit_math.cjs
!tools/fix_math_text.cjs
!tools/apply_choice_tables.cjs
!tools/apply_answerable.cjs
!tools/d1_dump.cjs
!tools/predeploy.cjs
!tools/build_exams.cjs
!tools/apply_ai.cjs
!tools/fix_ai_defects.cjs
!tools/fix_ai_reasoning.cjs
!tools/balance_ai_answers.cjs
!tools/audit_ai.cjs
!tools/import_snapshot.cjs
# The authored AI questions are the only copy of themselves - the local D1 they
# are imported into is not tracked, so this directory is the source of record.
!tools/aiq/
# Practice-test position -> bank ID map: generated from tracked inputs, IDs only.
!tools/ptmap/
# Prepzy Desmos solutions: the pipeline, mapping.json and the generated SQL are tracked. The raw cache,
# the scraped records and the review sheets hold College Board question text (and the cache is raw
# Prepzy responses), so they stay local like data/.
!tools/desmos/
tools/desmos/cache/
tools/desmos/solutions.jsonl
tools/desmos/review.csv
tools/desmos/unmatched.csv
tools/desmos/verify.json
!tools/restore_bluebook.cjs
!tools/bluebook_explanations.json
!tools/bluebook_stem_fixes.json
!tools/bluebook_skill_fixes.json
tools/templates.npz
backup/
d1_chunks/
# Regenerable from tools/aiq/*.jsonl by tools/apply_ai.cjs.
d1_ai/
# Playwright CLI output (may contain credentials)
.playwright-cli/
# Question-bank snapshot (College Board content). Fetched once from the external
# endpoint into data/questions.snapshot.json; never commit it in this public fork.
data/

# Generated role-gated React admin bundle
/public/admin.js
!tools/budget_*.cjs
